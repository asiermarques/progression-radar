{
  "name": "progression-radar",
  "version": "1.2.0",
  "description": "A simple visualisation tool for career and learning paths.",
  "license": "MIT",
  "homepage": "https://github.com/asiermarques/progression-radar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asiermarques/progression-radar.git"
  },
  "bugs": {
    "url": "https://github.com/asiermarques/progression-radar/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "index.html",
    "vite.config.ts",
    "src/",
    "!src/**/*.test.*",
    "scripts/",
    "!scripts/**/*.test.*",
    "!scripts/adopter-fixture.mjs",
    "!scripts/config-migrate.mjs",
    "config.example/",
    "public/",
    ".claude/skills/"
  ],
  "scripts": {
    "dev": "node scripts/cli.mjs dev",
    "build": "tsc --noEmit && node scripts/cli.mjs build",
    "preview": "node scripts/cli.mjs preview",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "config:migrate": "node scripts/config-migrate.mjs",
    "config:convert-categories": "node scripts/cli.mjs config convert-categories",
    "snapshot:record": "node scripts/cli.mjs snapshot record",
    "snapshot:link": "node scripts/cli.mjs snapshot link",
    "snapshot:check": "node scripts/cli.mjs snapshot check",
    "snapshot:report": "node scripts/cli.mjs snapshot report",
    "check": "node scripts/cli.mjs check"
  },
  "dependencies": {
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "mdast-util-from-markdown": "^2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "vite": "^8.3.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "bin": {
    "progression-radar": "scripts/cli.mjs"
  },
  "preferUnplugged": true
}
